# Key names only — never commit values (standards/security.md).
# Copy to `.env` and fill from each merchant's Shopify admin.
#
# The Storefront token is public and read-only; scope it to
# unauthenticated_read_product_listings. Never an Admin API token:
# that one grants writes and must never reach a device.
#
# react-native-config reads this file at BUILD time. After changing a
# key you need `yarn ios` / `yarn android` again — a Metro reload will
# not pick it up.

# ── platform ────────────────────────────────────────────────────────
# One app talks to one Storefront version, so this is not per merchant.
SHOPIFY_API_VERSION=

# ── per merchant ────────────────────────────────────────────────────
# One pair per merchant, prefixed with the merchant's `id` in upper case
# (see src/config/merchant/merchants/). Only the merchant selected by
# ACTIVE_MERCHANT_ID is validated at startup, so you can run with just
# the credentials you actually hold.

NORTHSTAR_STORE_DOMAIN=
NORTHSTAR_STOREFRONT_TOKEN=
NORTHSTAR_STORE_PASSWORD=

ATLAS_STORE_DOMAIN=
ATLAS_STOREFRONT_TOKEN=
ATLAS_STORE_PASSWORD=

# The store password exists only while the store is a development store: Shopify
# answers a cookieless visit with its password page, so the checkout WebView
# submits that form before loading the checkout. Leave it empty for an open store
# and no pre-auth step runs. Online Store → Preferences → Store access.

# ── seeding only, never read by the app ─────────────────────────────
# The Admin token is NOT set here. It lives in ~/.config/<merchant>-poc/
# admin-token.sh (mode 600) and is sourced only when running
# scripts/seed-catalog.mjs. See that script's header.
